# Loaded by `vite build`/`vite preview` (i.e. `npm run build`, `npm run
# preview`, `npm run dev:prod`). Only VITE_-prefixed vars are exposed to
# client code, via import.meta.env.
VITE_APP_ENV=production

# Left blank on purpose: same reasoning as .env.development — the built
# app is served same-origin with the API, so relative /api/* paths need no
# base URL. Fill this in only once the frontend and backend are actually
# deployed on separate hosts, and update src/lib/api.js to use it.
VITE_API_BASE_URL=
