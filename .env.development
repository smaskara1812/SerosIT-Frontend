# Loaded by `vite`/`vite build --mode development` (i.e. `npm run dev`,
# `npm run build:dev`, `npm run preview:dev`). Only VITE_-prefixed vars are
# exposed to client code, via import.meta.env.
VITE_APP_ENV=development

# Left blank on purpose: the app calls relative /api/* paths, and Vite's dev
# server proxies /api to localhost:8000 (see server.proxy in vite.config.js)
# — same-origin, no CORS to configure. Set this if the frontend and backend
# ever need to live on different hosts (e.g. a deployed API), and update
# src/lib/api.js to prefix requests with it.
VITE_API_BASE_URL=
